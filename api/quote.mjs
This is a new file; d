
export async function POST(request) {
  try {
    const body = await request.json();

    const name = String(body.name || "").trim();
    const email = String(body.email || "").trim();
    const service = String(body.service || "").trim();
    const message = String(body.message || "").trim();

    if (!name || !email || !service) {
      return Response.json(
        { success: false, message: "Please provide your name, email and service." },
        { status: 400 }
      );
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return Response.json(
        { success: false, message: "Please enter a valid email address." },
        { status: 400 }
      );
    }

    const apiKey = process.env.RESEND_API_KEY;
    const recipient = process.env.QUOTE_TO_EMAIL;

    if (!apiKey || !recipient) {
      return Response.json(
        { success: false, message: "Email service is not configured yet." },
        { status: 500 }
      );
    }

    const response = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${apiKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        from: process.env.QUOTE_FROM_EMAIL || "Ramaza Inv. <onboarding@resend.dev>",
        to: [recipient],
        reply_to: email,
        subject: `New Ramaza Inv. quote request: ${service}`,
        text: [
          "New quote request received.",
          "",
          `Customer: ${name}`,
          `Email: ${email}`,
          `Service: ${service}`,
          `Details: ${message || "No additional details provided."}`
        ].join("\n")
      })
    });

    const result = await response.json();

    if (!response.ok) {
      console.error("Resend email error:", result);
      return Response.json(
        { success: false, message: "Email delivery failed. Check sender verification and settings." },
        { status: 502 }
      );
    }

    return Response.json({
      success: true,
      message: "Quote request sent successfully."
    });
  } catch (error) {
    console.error("Quote API error:", error);
    return Response.json(
      { success: false, message: "Unable to process the quote request." },
      { status: 500 }
    );
  }
}
